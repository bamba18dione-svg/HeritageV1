# Configuration de la base de données
# Pour Neon, utiliser l'URL fournie par le bouton "Connect".
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Alternative pour une connexion PostgreSQL locale :
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=heritage_v1
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
